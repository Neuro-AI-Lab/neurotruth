# NeuroTruth local environment

# Postgres
POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=mydb

# Backend database URL is assembled by apps/db/docker-compose.yml for Docker.
# For non-Docker local runs, set DATABASE_URL directly if needed.
# DATABASE_URL=postgresql+asyncpg://myuser:changeme_strong_password@localhost:5432/mydb

# Host-published ports. The backend listens on container port 25991; rPPG keeps
# its separate internal/LAN port 8000 on the DGX Spark.
BACKEND_HOST_PORT=25991
WEB_HOST_PORT=45511
POSTGRES_HOST_PORT=44551

# V2.5 security (required by the authenticated backend)
# Generate each AES key as 32 random bytes and base64-encode it. Multiple keys
# support rotation: v1:<base64>,v2:<base64>. Never commit actual values.
DATA_ENCRYPTION_KEYS_B64=v1:replace-with-base64-encoded-32-byte-key
DATA_ENCRYPTION_CURRENT_KEY_ID=v1
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
ADMIN_SIGNUP_CODE=replace-with-one-time-admin-signup-code
SENSOR_STORAGE_ROOT=/var/lib/neurotruth/sensors
APP_ENV=development
# Explicitly opt in only for local/LAN experiments. Production rejects this.
ALLOW_INSECURE_HTTP=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Fictional VP-012 recording scenario. Keep disabled outside an explicit demo.
# Supply DEMO_PATIENT_PASSWORD locally; never commit its real value.
DEMO_SCENARIO_ENABLED=false
DEMO_PATIENT_PASSWORD=

# Binary craving model (20-second PPG/GSR, class 0=low, class 1=high)
CRAVING_MODEL_PATH=/app/model/weights/final_model_win20s_high2p4/model_weights.pt
CRAVING_MODEL_METADATA_PATH=/app/model/weights/final_model_win20s_high2p4/model_metadata.json
CRAVING_MODEL_SHA256=2493e5d75fcdc9b066b341deb47f81c9db49aac37c626619b7afe1a6b2fc354c
CRAVING_INFERENCE_DEVICE=auto

# AWS Bedrock GPT-5.5 through the Mantle Responses API
# OpenAI models require a bearer token through this exact env var.
AWS_BEARER_TOKEN_BEDROCK=put-your-bedrock-api-key-here
BEDROCK_MODEL_ID=openai.gpt-5.5
AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
# BEDROCK_TIMEOUT_SECONDS=60

# Optional Bedrock state-summary and report generation. Intervention dialogue
# remains active; these two capabilities are preserved but disabled by default.
STATE_SUMMARY_AI_ENABLED=false
REPORT_AI_ENABLED=false

# Watch-only alert rule: three consecutive danger-stage predictions followed
# by a patient-wide 15-minute cooldown.
ALERT_DANGER_THRESHOLD=0.75
ALERT_DANGER_STREAK=3
ALERT_MAX_GAP_SECONDS=20
ALERT_COOLDOWN_SECONDS=900
# Remove deprecated ALERT_WINDOW_SIZE, ALERT_RECOMMEND_COUNT,
# ALERT_HIGH_STREAK, and ALERT_DOWNTREND_DELTA from deployed environment files.

# Runtime tuning
INFERENCE_QUEUE_MAX=100
SSE_KEEPALIVE_SECONDS=10

# Optional internal Korean Whisper STT service. Keep disabled until the model
# is mounted on the local or DGX host.
STT_ENABLED=false
STT_MODEL_PATH=../../models/whisper-large-v3-turbo
STT_PYTORCH_MODEL_PATH=../../models/whisper-large-v3-turbo-pytorch
STT_DEVICE=auto
STT_ALLOW_CPU_FALLBACK=true
STT_CONNECT_TIMEOUT_SECONDS=5
STT_READ_TIMEOUT_SECONDS=120
STT_MAX_UPLOAD_MIB=10

# Optional DGX Spark FactorizePhys rPPG extension. It is enabled by default but
# remains readiness/release-gated; set RPPG_ENABLED=false to turn it off.
RPPG_ENABLED=true
RPPG_BASE_URL=http://192.168.68.50:8000
RPPG_CONNECT_TIMEOUT_SECONDS=10
RPPG_READ_TIMEOUT_SECONDS=180
RPPG_MAX_UPLOAD_MIB=40
RPPG_MAX_CONCURRENCY=1
RPPG_STORAGE_ROOT=/var/lib/neurotruth/rppg
