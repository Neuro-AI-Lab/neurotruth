# ──────────────────────────────────────────
# DB 설정 (서버 B)
# ──────────────────────────────────────────
POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=mydb

# ──────────────────────────────────────────
# 백엔드 설정 (서버 B)
# ──────────────────────────────────────────
# DB URL은 docker-compose에서 자동 조합됨 (수동 설정 불필요)
# DATABASE_URL=postgresql+asyncpg://myuser:changeme@db:5432/mydb

# GPU 서버 주소 (서버 A의 공인 IP 또는 도메인)
LLM_SERVER_URL=http://<GPU서버_IP>:8001

# LLM 서버 인증 키 (서버 A와 동일한 값으로 설정)
LLM_API_KEY=your-secret-key-here

# ──────────────────────────────────────────
# LLM 서버 설정 (서버 A - GPU 서버)
# ──────────────────────────────────────────
# 외부 API 방식 사용 시
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# 이 서버의 인증 키 (백엔드와 동일한 값)
# LLM_API_KEY=your-secret-key-here
