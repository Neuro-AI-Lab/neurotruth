# NeuroTruth local environment

# Postgres
POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=mydb

# Backend database URL is assembled by apps/db/docker-compose.yml for Docker.
# For non-Docker local runs, set DATABASE_URL directly if needed.
# DATABASE_URL=postgresql+asyncpg://myuser:changeme_strong_password@localhost:5432/mydb

# Host-published ports. The backend listens on container port 25991; rPPG keeps
# its separate internal/LAN port 8000 on the DGX Spark.
BACKEND_HOST_PORT=25991
WEB_HOST_PORT=3000

# V2.5 security (required by the authenticated backend)
# Generate each AES key as 32 random bytes and base64-encode it. Multiple keys
# support rotation: v1:<base64>,v2:<base64>. Never commit actual values.
DATA_ENCRYPTION_KEYS_B64=v1:replace-with-base64-encoded-32-byte-key
DATA_ENCRYPTION_CURRENT_KEY_ID=v1
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
ADMIN_SIGNUP_CODE=replace-with-one-time-admin-signup-code
SENSOR_STORAGE_ROOT=/var/lib/neurotruth/sensors
APP_ENV=development
# Explicitly opt in only for local/LAN experiments. Production rejects this.
ALLOW_INSECURE_HTTP=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Local craving model
# Docker default: /app/model/weights/rf_dependent.joblib
# Local default from apps/backend: apps/backend/model/weights/rf_dependent.joblib
# MODEL_PATH=C:/path/to/rf_dependent.joblib

# AWS Bedrock GPT-5.5 through the Mantle Responses API
# OpenAI models require a bearer token through this exact env var.
AWS_BEARER_TOKEN_BEDROCK=put-your-bedrock-api-key-here
BEDROCK_MODEL_ID=openai.gpt-5.5
AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
# BEDROCK_TIMEOUT_SECONDS=60

# Alert rule tuning
ALERT_WINDOW_SIZE=10
ALERT_RECOMMEND_MIN=0.6
ALERT_REQUIRED_MIN=1.5
ALERT_HIGH_STREAK=3
ALERT_COOLDOWN_SECONDS=30
ALERT_DOWNTREND_DELTA=0.6

# Runtime tuning
INFERENCE_QUEUE_MAX=100
SSE_KEEPALIVE_SECONDS=10

# Optional DGX Spark FactorizePhys rPPG extension. Keep disabled until the
# controlled real-phone end-to-end release gate passes.
RPPG_ENABLED=false
RPPG_BASE_URL=http://192.168.68.50:8000
RPPG_CONNECT_TIMEOUT_SECONDS=10
RPPG_READ_TIMEOUT_SECONDS=180
RPPG_MAX_UPLOAD_MIB=20
RPPG_MAX_CONCURRENCY=1
RPPG_STORAGE_ROOT=/var/lib/neurotruth/rppg
